{
  "name": "@larvit/adf-codec",
  "version": "0.1.0",
  "description": "Convert Atlassian Document Format (ADF) to and from markdown and HTML, with a lossless round-trip.",
  "keywords": [
    "adf",
    "atlassian",
    "atlassian-document-format",
    "commonmark",
    "confluence",
    "converter",
    "html",
    "jira",
    "markdown",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larvit/adf-codec.git"
  },
  "bugs": "https://github.com/larvit/adf-codec/issues",
  "homepage": "https://github.com/larvit/adf-codec#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "size-ratchet": "oxlint --deny-warnings -c .oxlintrc.json src",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=src/conformance/property-harness.ts --test-coverage-branches=98 --test-coverage-functions=100 --test-coverage-lines=100 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "fast-check": "4.10.2",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  }
}
