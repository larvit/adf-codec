{
  "name": "@larvit/adf-codec",
  "version": "0.3.1",
  "description": "ADF converter: ADF to markdown, HTML, Jira wiki markup or plain text, and markdown, HTML or Jira wiki markup to ADF. ADF is Atlassian Document Format, the rich text of Jira and Confluence.",
  "keywords": [
    "adf",
    "adf-to-html",
    "adf-to-markdown",
    "adf-to-plain-text",
    "adf-to-wiki",
    "atlassian",
    "atlassian-document-format",
    "atlassian-forge",
    "commonmark",
    "confluence",
    "converter",
    "esm",
    "forge",
    "gfm",
    "html",
    "html-to-adf",
    "jira",
    "jira-wiki-markup",
    "lossless",
    "markdown",
    "markdown-to-adf",
    "round-trip",
    "typescript",
    "wiki-to-adf",
    "zero-dependencies"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larvit/adf-codec.git"
  },
  "bugs": "https://github.com/larvit/adf-codec/issues",
  "homepage": "https://github.com/larvit/adf-codec#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --deny-warnings -c .oxlintrc.json src",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=src/conformance/property-harness.ts --test-coverage-branches=98 --test-coverage-functions=100 --test-coverage-lines=100 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "fast-check": "4.11.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2"
  }
}
